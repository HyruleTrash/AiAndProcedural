\par
{\bkmkstart AAAAAAAAYU}
{\bkmkend AAAAAAAAYU}
{
\pard\plain \s61\li360\sa60\sb30\qj\widctlpar\qj\adjustright \fs20\cgrid 
\par
{
{\s17\sa60\sb30\widctlpar\qj \fs22\cgrid 
Gets all possible doorways, then checks overlap, and places a boss room fitting the adjecent area. }}\par
{
\par
\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 347         \{\par
348             AnimDataWrapper animData = {\cf17 new}({\cf17 this}, this.unityConnection, this.owner.GetAnimYieldInstruction(),\par
349                 this.owner.GetAnimWaitTime());\par
350             this.walkDirRepeatSetting = RepeatSetting.World;\par
351             \par
352             List<(RoomRuntime room, Vector2Int position, Vector2Int direction)> doorPositions = this.gridRuntime.GetAllPossibleDoorPositions()\par
353                 .Where(d => Vector2.Distance(d.position, Vector2.zero) >= {\cf17 this}.minDistToBossRoom)\par
354                 .OrderByDescending(d => Vector2.Distance(d.position, Vector2.zero))\par
355                 .ToList();\par
356 \par
357             {\cf19 for} ({\cf18 int} i = 0; i < doorPositions.Count; i++)\par
358             \{\par
359                 (RoomRuntime room, Vector2Int position, Vector2Int direction) door = doorPositions[i];\par
360                 this.CurrentPosition = door.room.position;\par
361                 this.currentWalkDirection = door.direction;\par
362                 \par
363                 {\cf19 if} (Vector2.Distance(door.position + door.room.position, Vector2.zero) < {\cf17 this}.minDistToBossRoom) {\cf19 continue};\par
364 \par
365                 AreaRuntime area = GetHadAreaByType(door.room.areaType);\par
366 \par
367                 PendingRoomPlacement pendingRoom = {\cf17 new}();\par
368                 yield {\cf19 return} this.unityConnection.StartCoroutine(area.GetPossibleBossRoom(animData, pendingRoom));\par
369 \par
370                 {\cf18 float} dist = pendingRoom.possibleRoom != {\cf17 null}\par
371                     ? Vector2.Distance(pendingRoom.center!.Value, Vector2.zero)\par
372                     : 0;\par
373                 {\cf19 if} (dist < this.minDistToBossRoom)\par
374                 \{\par
375                     Debug.Log(${\cf22 "Boss room not possible or too close, at door \{i\}"});\par
376                     {\cf19 continue};\par
377                 \}\par
378 \par
379                 RoomRuntimeRef runtimeRef = {\cf17 new}();\par
380                 yield {\cf19 return} this.unityConnection.StartCoroutine(AddRoom(area, pendingRoom, runtimeRef));\par
381 \par
382                 {\cf19 if} (runtimeRef.instance == {\cf17 null}) {\cf19 continue};\par
383 \par
384                 NotificationManager.Log(${\cf22 "Boss room added, \{dist\} from start"}, this.owner.GetAnimWaitTime());\par
385                 bossRoomRef.instance = runtimeRef.instance;\par
386                 this.CurrentPosition = bossRoomRef.instance.position;\par
387                 yield {\cf19 break};\par
388             \}\par
389         \}\par
}
}

{\s17\sa60\sb30\widctlpar\qj \fs22\cgrid 
Translates a texture to a internally used layout text, based on a lookup table singleton. }}\par
{
\par
\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 62         \{\par
63             StringBuilder result = {\cf17 new}();\par
64             Color32[] pixels = texture.GetPixels32();\par
65 \par
66             {\cf17 const} {\cf18 float} tolerance = 0.1f;\par
67             {\cf18 bool} CheckColor(Color a, Color b) => \par
68                 Math.Abs(a.r - b.r) < tolerance && \par
69                 Math.Abs(a.g - b.g) < tolerance && \par
70                 Math.Abs(a.b - b.b) < tolerance && \par
71                 Math.Abs(a.a - b.a) < tolerance;\par
72             \par
73             RoomTileLookup? lookupInstance = RoomTileLookup.LookupInstance;\par
74             {\cf19 if} (lookupInstance == {\cf17 null} || lookupInstance.tiles == {\cf17 null}) {\cf19 return} result.ToString();\par
75             \par
76             {\cf19 for} ({\cf18 int} y = 0; y < texture.height; y++)\par
77             \{\par
78                 {\cf19 for} ({\cf18 int} x = 0; x < texture.width; x++)\par
79                 \{\par
80                     Color32 pixel = pixels[y * texture.width + x];\par
81 \par
82                     {\cf18 bool} found = {\cf17 false};\par
83                     {\cf19 foreach} (RoomTileLookup.ListInstance lookupInstanceTile in lookupInstance.tiles)\par
84                     \{\par
85                         {\cf19 if} (!CheckColor(pixel, lookupInstanceTile.tile.color))\par
86                             {\cf19 continue};\par
87                         result.Append(lookupInstanceTile.tile.text);\par
88                         found = {\cf17 true};\par
89                         {\cf19 break};\par
90                     \}\par
91                     {\cf19 if} (!found) \par
92                         Debug.Log(${\cf22 "Unexpected color: \{pixel\}"});\par
93                 \}\par
94             \}\par
95     \par
96             {\cf19 return} result.ToString();\par
97         \}\par
}
}
